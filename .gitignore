# *.aab - 现在通过 LFS 管理

# 排除其他大的发布文件
app/release/

# JNI库文件现在通过 LFS 管理
# app/src/main/jniLibs/ - 现在通过 LFS 管理
/log.ini
/app/debug
/Rerankers
/ref

# ========== MNN Submodule - Custom Operators Protection ==========
# MNN is a git submodule, but we need to protect our custom CPU operators
# from being overwritten when updating the submodule
# Custom operators are in: libs/mnn/source/backend/cpu/CPUGroupNorm.*
#
# Note: If MNN uses shallow submodule ignore, add these exceptions:
# !libs/mnn/source/backend/cpu/CPUGroupNorm.cpp
# !libs/mnn/source/backend/cpu/CPUGroupNorm.hpp
# !libs/mnn/source/backend/cpu/README_CUSTOM_OPS.md
/allinone

/.env

# Stockquant skill runtime data (per-user; do not commit)
app/src/main/assets/skills/stockquant/cache/
app/src/main/assets/skills/stockquant/logs/

# Python bytecode cache left behind when running .py scripts locally
# (conda/venv). Not needed in VCS and already excluded from APK builds
# via `androidResources.ignoreAssetsPattern` in app/build.gradle.
**/__pycache__/
*.pyc
/MAI-UI
/Open-AutoGLM
/_inspect
/skill_example
/tonghuashuntupian
/tests
/stockquant_log

/app/src/main/assets/skills/stockquant/config/tushare_state.json

# KleidiAI junction created by mnn-lib CMakeLists.txt to fix CMAKE_SOURCE_DIR path mismatch
libs/mnn-lib/src/main/cpp/source/

